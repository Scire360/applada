{
  "realm": "applada",
  "enabled": true,
  "displayName": "Applada",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Applada</span></div>",
  "loginTheme": "applada",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "sslRequired": "external",
  "registrationEmailAsUsername": false,
  "duplicateEmailsAllowed": false,
  "users": [
    {
      "username": "teste-rate-limit",
      "enabled": true,
      "email": "teste-rate-limit@localhost",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "TesteRateLimit!2026",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "applada-web",
      "name": "Applada Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "applada-local-development-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login"
      },
      "protocolMappers": [
        {
          "name": "audience-applada-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "applada-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
