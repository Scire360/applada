    "/api/v1/me/matches": {
      "get": {
        "tags": [
          "Matches"
        ],
        "operationId": "ListMyMatches",
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "description": "Obrigat\u00F3rio: organizer (partidas que organizo) ou participant (inscri\u00E7\u00E3o ativa).",
            "required": true,
            "schema": {
              "enum": [
                "organizer",
                "participant"
              ],
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Cursor opaco devolvido em nextCursor; s\u00F3 vale para esta listagem.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Itens por p\u00E1gina, de 1 a 50 (padr\u00E3o 20).",
