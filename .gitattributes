# Normaliza finais de linha no repositório (equipe em Windows e Linux)
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.ttf binary
*.woff binary
*.woff2 binary
*.pdf binary
