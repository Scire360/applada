# Gere um segredo de sessão com `npx auth secret` e guarde-o em .env.local.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Keycloak de dev (AppHost Aspire). O segredo do client applada-web de dev está em
# infra/keycloak/applada-dev-realm.json (valor somente local); copie-o para .env.local.
AUTH_KEYCLOAK_ID=applada-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/applada

# API do Applada (AppHost).
APPLADA_API_URL=http://localhost:5080
