# Gere um segredo de sessão com `npx auth secret` e guarde-o em .env.local.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Configure um cliente OIDC confidencial no Keycloak.
AUTH_KEYCLOAK_ID=applada-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=https://keycloak.example.com/realms/applada

# Origem server-side da API .NET; em produção use somente HTTPS.
APPLADA_API_ORIGIN=http://localhost:5080
